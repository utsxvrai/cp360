{
  "app_name": "cp360",
  "region": "ap-south-1",
  "container_port": 3000,
  "health_check_path": "/health",
  "cpu": 256,
  "memory": 512,
  "desired_count": 1,
  "autoscaling": {
    "enabled": false,
    "min": 1,
    "max": 1
  },
  "database": {
    "enabled": false,
    "engine": "postgres",
    "version": "16",
    "instance": "db.t4g.micro",
    "storage_gb": 20,
    "multi_az": false,
    "backup_days": 1,
    "deletion_protection": false
  },
  "storage": {
    "enabled": false,
    "cors": false
  },
  "env": [
    {
      "name": "PORT",
      "source": "port",
      "value": ""
    },
    {
      "name": "NODE_ENV",
      "source": "plain",
      "value": "production"
    },
    {
      "name": "FRONTEND_URL",
      "source": "plain",
      "value": ""
    },
    {
      "name": "SUPABASE_URL",
      "source": "plain",
      "value": ""
    },
    {
      "name": "SUPABASE_SERVICE_ROLE_KEY",
      "source": "plain",
      "value": ""
    },
    {
      "name": "JWT_SECRET",
      "source": "generated_secret",
      "value": ""
    },
    {
      "name": "JWT_EXPIRY",
      "source": "plain",
      "value": "7d"
    }
  ],
  "domain": {
    "name": "",
    "certificate_ready": false
  },
  "cdn_enabled": false,
  "access_logs": true
}
