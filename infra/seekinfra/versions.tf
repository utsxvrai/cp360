# Generated by SeekInfra from vetted templates. Values live in terraform.tfvars.json.
terraform {
  required_version = ">= 1.10"
  required_providers {
    aws    = { source = "hashicorp/aws", version = "~> 6.0" }
    random = { source = "hashicorp/random", version = "~> 3.6" }
  }
  # Bucket, key and region are passed by the workflow (-backend-config); state locking uses S3 lockfiles.
  backend "s3" {}
}

provider "aws" {
  region = var.region
  default_tags {
    tags = {
      "seekinfra:app" = var.app_name
      ManagedBy       = "seekinfra"
    }
  }
}

data "aws_caller_identity" "current" {}
data "aws_availability_zones" "available" { state = "available" }

locals {
  name = "seekinfra-${var.app_name}"
  azs  = slice(data.aws_availability_zones.available.names, 0, 2)
}
